# Optional root Docker Compose interpolation only.
# Backend private configuration belongs to logistic-x-backend/.env.
# Preserve an existing root .env; it is not read by either application at runtime.
EXPO_PUBLIC_API_URL=http://localhost:8000/v1
EXPO_PUBLIC_APP_ENV=development
LOGISTIC_X_CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
