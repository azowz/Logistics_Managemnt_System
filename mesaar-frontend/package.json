{
  "name": "mesaar-frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web --port 8081",
    "build": "expo export --platform web",
    "preview": "node scripts/serve.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test --project=standalone",
    "test:integration": "playwright test --project=integration",
    "api:generate": "openapi-typescript api/openapi.json -o src/api/generated.ts",
    "api:check": "openapi-typescript api/openapi.json -o src/api/generated.ts --check",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/tajawal": "^0.2.3",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-router": "~3.5.23",
    "expo-splash-screen": "~0.27.5",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native-web": "~0.19.10",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.45",
    "typescript": "~5.3.3",
    "@types/node": "22.15.30",
    "tsx": "4.20.5",
    "openapi-typescript": "7.6.1",
    "@playwright/test": "1.52.0"
  },
  "private": true
}
