# All EXPO_PUBLIC_* values are public and embedded at build time. No secrets here.
EXPO_PUBLIC_API_URL=http://localhost:8000/v1
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_USE_MOCK=false
# Staging: set APP_ENV=staging and an HTTPS API URL before build.
# Production: set APP_ENV=production and an HTTPS API URL before build.
# Demo fixtures: USE_MOCK=true only in development (visibly labelled in the UI).
